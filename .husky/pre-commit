#!/usr/bin/env sh


echo "🔍 Running Backend TypeScript type check..."
cd Backend || exit 1

npm run type-check || exit 1

echo "🧹 Running Backend ESLint..."
npm run lint || exit 1

echo "✨ Running Backend lint-staged..."
npx lint-staged || exit 1

cd ..

echo "🎨 Running Frontend Prettier..."
cd Frontend || exit 1

npm run format || exit 1

echo "✅ Pre-commit checks passed!"